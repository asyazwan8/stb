# fal.ai API key — required for the face swap.
# Get it from https://fal.ai/dashboard/keys and set it in
# Vercel > Project > Settings > Environment Variables.
FAL_KEY=

# Optional: override the face-swap model endpoint.
# Defaults to fal-ai/nano-banana-pro/edit
# FAL_MODEL=fal-ai/nano-banana-2/edit

# Phone-controlled mode (/demo-qr) — set automatically when you add
# Upstash for Redis in Vercel > Storage. Not needed for local dev.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
